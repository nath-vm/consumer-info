# Google OAuth Web client ID (same one the backend uses). Public by design.
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: secret-ish URL path for the admin login page (default: p3-admin).
# This only hides the page; real protection is the Google sign-in + approved-email list.
REACT_APP_ADMIN_ROUTE=p3-admin
