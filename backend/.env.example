# Copy this file to .env and fill in real values. NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Number of reverse-proxy hops in front of the app (Render = 1). Optional.
# If every audit-log entry shows the same IP, try 2.
TRUST_PROXY=1

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DatabaseName?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────────────
# Signs login tokens. Min 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_openssl_rand_-hex_32_OUTPUT

# Google OAuth Web client ID (admins sign in with Google). Not secret, but required.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The first admin: this Google account is auto-approved on first login
# (only while the admin whitelist is empty).
BOOTSTRAP_ADMIN_EMAIL=your-email@gmail.com

# ─── Email notifications (optional, via Resend) ───────────────────────────────
# Needed for automatic password rotation and admin alert emails. If unset, the app
# still works; rotation is skipped (never rotates without being able to email the new password).
RESEND_API_KEY=re_your_resend_api_key
# Sender. The default (onboarding@resend.dev) can ONLY deliver to the email address that
# owns your Resend account. To email anyone else, verify a domain in Resend and use e.g.:
# MAIL_FROM=Consumer Info <alerts@yourdomain.com>
MAIL_FROM=
