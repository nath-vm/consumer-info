# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in YOUR values.
# NEVER commit backend/.env. It is listed in .gitignore.
# On Render, set these in the dashboard (Environment tab) instead of using a file.
# The server refuses to start if a REQUIRED value is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Secret used to sign login tokens. At least 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# MongoDB connection string (Atlas: Connect > Drivers). Use a dedicated database user.
# For local demos use a database whose name contains "demo" (see `npm run seed:demo`).
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/consumerinfo?retryWrites=true&w=majority

# Google OAuth Client ID (Google Cloud Console > APIs & Services > Credentials).
# Must be the same client ID the frontend uses (REACT_APP_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# "production" on Render (turns on Secure cookies). Leave as "development" locally.
NODE_ENV=development

# Port to listen on. Render sets this automatically.
PORT=5000

# The FIRST admin who may sign in, before any admin exists in the database.
# After the first login, manage admins in the Admin Settings screen.
BOOTSTRAP_ADMIN_EMAIL=you@gmail.com

# Email notifications via Brevo (https://www.brevo.com). Leave blank to disable emails.
BREVO_API_KEY=
# The "from" address for notification emails. Must be a sender verified in Brevo.
SMTP_USER=

# How many reverse proxies sit in front of the API (used for client IPs / rate limiting).
# Render's load balancer = 1. See README > Known limitations.
TRUST_PROXY_HOPS=1

# URL path of the admin screen, used to redirect back after Google sign-in. Must match the
# frontend's REACT_APP_ADMIN_ROUTE (default p3-admin).
ADMIN_ROUTE=p3-admin
