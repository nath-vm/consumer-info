{
  "name": "consumer-info-backend",
  "version": "1.0.0",
  "description": "REST API for the Consumer Information System: Express + MongoDB, Google admin login, shared-password user access with refresh tokens, and a password-rotation scheduler.",
  "private": true,
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "audit:prod": "npm audit --omit=dev",
    "seed:demo": "node scripts/seedDemoData.js"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
