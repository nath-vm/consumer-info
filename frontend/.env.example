# Copy to frontend/.env for local development. On Vercel, set these under
# Project > Settings > Environment Variables.
#
# IMPORTANT: everything starting with REACT_APP_ is compiled into the public JavaScript
# bundle and visible to every visitor. Never put a secret here.

# Google OAuth Client ID (public by design). Must match the backend GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: URL path of the admin screen. Default is "p3-admin".
# This is only a convenience, NOT a security control; the server enforces admin access.
REACT_APP_ADMIN_ROUTE=p3-admin
